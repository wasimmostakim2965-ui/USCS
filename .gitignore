# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# Terraform state and its secrets — the environment file holds engine
# credentials, so the state file is as sensitive as `.env` itself.
infra/aws/terraform/.terraform/
infra/aws/terraform/*.tfstate
infra/aws/terraform/*.tfstate.*
infra/aws/terraform/*.tfvars
infra/aws/terraform/crash.log

# Engine reference clones — read-only inspection workspaces, never committed.
# Each engine stays an independent, version-pinned service behind an adapter.
/engines-src/

# Environment and secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
*.log

# Local tooling shim (pnpm wrapper for environments without a pnpm binary)
.bin/
