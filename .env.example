# Cloud Wai environment template.
#
# Copy to .env and fill in real values. Nothing here has a working default:
# an engine that is not configured must make its adapter report
# `not_configured`, never a simulated success.

# --- Control plane (Supabase) ------------------------------------------------
# The only browser identity source. Control-plane database only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Orchestration queue (Valkey) --------------------------------------------
# Rebuildable cache/queue only; never billing, identity or audit truth.
VALKEY_URL=

# --- Hosting engine (Coolify) ------------------------------------------------
# Version-pinned engine behind HostingAdapter. Never an identity source.
COOLIFY_BASE_URL=
COOLIFY_API_TOKEN=
COOLIFY_DEFAULT_TEAM_ID=

# --- Tenant database plane (PostgreSQL) --------------------------------------
# Separate credentials/network from the control plane.
TENANT_POSTGRES_ADMIN_URL=
TENANT_POSTGRES_BACKUP_BUCKET=

# --- Storage engine (MinIO / S3-compatible) ----------------------------------
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Security edge -----------------------------------------------------------
# Edge is selected after benchmarking; Envoy is the default candidate.
EDGE_IMPLEMENTATION=envoy
EDGE_ADMIN_URL=
CRS_VERSION=4.30.0
CROWDSEC_LAPI_URL=
CROWDSEC_API_KEY=

# --- Domain reseller ---------------------------------------------------------
# Registration requires credentials and legal approval; unset means the
# DomainResellerAdapter reports not_configured.
DOMAIN_RESELLER_API_KEY=

# --- Telemetry ---------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
