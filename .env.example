# Cloud Wai environment template.
#
# Copy to .env and fill in real values. Nothing here has a working default:
# an engine that is not configured must make its adapter report
# `not_configured`, never a simulated success.

# --- Control plane (Supabase) ------------------------------------------------
# The only browser identity source. Control-plane database only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Hosting engine (Coolify) ------------------------------------------------
# Version-pinned engine behind HostingAdapter. Never an identity source.
#
# Credentials are per organization — one Coolify team per tenant, one token per
# team. A shared token would erase the tenant boundary. The suffix is the Cloud
# Wai organization id.
#
# The per-organization forms below are shown as comments, not as keys, because a
# dotenv and the Compose `env_file` parser both reject a key containing `<`. Set
# them per tenant by substituting the organization id: for organization
# `f1a2…`, the key is `COOLIFY_TOKEN__f1a2…`.
COOLIFY_URL=
# COOLIFY_TOKEN__<organizationId>=<team-scoped-api-token>
# Coolify requires a project, server and environment to create an application,
# so they are part of a tenant's credential record.
# COOLIFY_PROJECT_UUID__<organizationId>=
# COOLIFY_SERVER_UUID__<organizationId>=
# COOLIFY_ENVIRONMENT_NAME__<organizationId>=production
# Optional: name the environment by uuid instead of by name.
# COOLIFY_ENVIRONMENT_UUID__<organizationId>=
# COOLIFY_DESTINATION_UUID__<organizationId>=

# --- Self-hosted runtime engine (this deployment's own container runtime) -----
# The Vercel-style container engine this platform owns, instead of renting
# Coolify. `RUNTIME_URL` plus at least one `RUNTIME_TOKEN__<organizationId>`
# makes it the container engine; without them the container engine falls back to
# Coolify, and with neither it stays honestly `not_configured`.
#
# The one-command deploy generates RUNTIME_TOKEN and wires every organization to
# RUNTIME_URL automatically, so these are only set by hand on a host that runs
# the runtime elsewhere.
# RUNTIME_URL=http://127.0.0.1:8095
# RUNTIME_TOKEN__<organizationId>=<the runtime's RUNTIME_TOKEN>
# RUNTIME_TOKEN=
# RUNTIME_PORT=8095
# The host a deployed app's url is built from. Empty advertises 127.0.0.1, which
# only the host can reach; set it to the app domain (or the load balancer DNS)
# for a deployment whose apps must be reachable on the public internet.
# RUNTIME_PUBLIC_HOST=apps.example.com

# --- Router (public domain and automatic TLS) --------------------------------
# The deployment's own front door (ADR-0021): it maps a verified hostname to a
# deployed app's loopback port and terminates TLS, issuing certificates over ACME
# (Let's Encrypt) with a self-signed fallback so a host is never served without
# TLS. Without it a verified domain is recorded but not reachable.
#
# The one-command deploy generates ROUTER_TOKEN and starts the router under the
# `edge` compose profile. `ROUTER_ACME_EMAIL` must be set for automatic issuance;
# `ROUTER_DEFAULT_UPSTREAM` is an optional fallback host upstream (the dashboard).
# ROUTER_TOKEN=
# ROUTER_URL=http://127.0.0.1:8096
# ROUTER_ACME_EMAIL=ops@example.com
# ROUTER_DEFAULT_UPSTREAM=http://127.0.0.1:12000
# Use a staging directory while testing so issuance does not hit rate limits.
# ROUTER_ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
# ROUTER_HTTP_PORT=80
# ROUTER_HTTPS_PORT=443
# ROUTER_ADMIN_PORT=8096

# --- Storage engine (MinIO / S3-compatible) ----------------------------------
# Read by `engineConfigFromEnv` as STORAGE_ENDPOINT plus per-organization keys.
# A credential without both an endpoint and a per-organization access/secret
# pair leaves storage honestly `not_configured`.
#
# The endpoint must be the address a client signs its `Host` header with. When
# the S3 protocol is served by Supabase's storage-api behind Kong, the signature
# is verified against `x-forwarded-host`/`x-forwarded-port` (Kong sets them from
# the request), so the endpoint has to be the Kong gateway origin, not the
# storage container and not the container's raw `/s3` route:
#   STORAGE_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
# Pointing it at the container (`http://<ip>:5000/s3`) makes every request fail
# with `SignatureDoesNotMatch`, because the Host Kong forwards back never
# matches the one the client signed.
STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY__<organizationId>=
# STORAGE_SECRET_KEY__<organizationId>=
# Region is part of the SigV4 scope and is per organization. It must equal the
# storage service's own region (`STORAGE_S3_REGION`, default `local`).
# STORAGE_REGION__<organizationId>=

# --- Security edge -----------------------------------------------------------
# The API and worker build the real edge adapter when these are set, so a policy
# distribution actually reaches the edge. Without them the edge stays honestly
# `not_configured` — never a stub that fabricates success.
#
# The edge's admin API, e.g. https://edge.internal:9443.
SECURITY_EDGE_URL=
# The private origin the edge forwards to. Deployment config, never customer
# input: a public origin is reachable directly, which is what the edge prevents.
# Must be a private address (10./172.16-31./192.168./169.254./fc00::/7), or the
# edge stays `not_configured`.
SECURITY_EDGE_ORIGIN=
# Per-organization edge admin tokens: SECURITY_EDGE_TOKEN__<organizationId>.
# SECURITY_EDGE_TOKEN__<organizationId>=
# Extra verified bots to allow on top of the curated crawler directory (Googlebot,
# Bingbot, UptimeRobot, ...). This is how a deployment trusts its *own* webhook
# providers and monitors so attack mode does not lock them out. Format is
# `name:userAgent:confirmSuffix` entries separated by `;`. The confirm suffix must
# be a DNS name the edge can forward-confirm, so a UA claim alone is never enough
# and a malformed entry is dropped (fail-closed) rather than emitted as a bypass.
# SECURITY_EDGE_BOT_ALLOWLIST=stripe:Stripebot:stripe.com;monitor:UptimeRobot:uptimerobot.com
# The edge hostname a domain may CNAME to. Without it, only the TXT challenge
# can verify a domain.
EDGE_HOSTNAME=

# --- Build engine (Nixpacks build plane, ADR-0018) ---------------------------
# Turns a Git source into a deployable image. It is the layer that lets a
# serverless or preview deployment exist at all; without it those paths report
# `not_configured` honestly. It is reached per organization, exactly like
# Coolify, at BUILD_ENGINE_URL__<organizationId> + BUILD_ENGINE_TOKEN__<orgId>.
#
# `infra/deployment/builder-server.mjs` is the service; `infra/deployment/
# builder.Dockerfile` is its image and the compose `builder` service (profile
# "build") is its topology. The builder's own token is a single secret because
# one builder process is one trust boundary — see docs/runbooks/build-plane.md
# for the single-host (shared builder) versus hardened (builder per tenant)
# shapes. A host that runs no builder sets none of these keys, and the build
# adapter stays honestly `not_configured`.
# BUILD_ENGINE_URL__<organizationId>=http://builder:8090
# BUILD_ENGINE_TOKEN__<organizationId>=<the builder's BUILDER_TOKEN>
# The builder's own environment (read by the builder service, not the API).
BUILDER_TOKEN=
BUILDER_PORT=8090
BUILDER_HOST=0.0.0.0
# How many builds may run at once and how long one may take, before the builder
# kills it. Each build drives a Docker build, so both bounds protect every other
# tenant on the host from one tenant's repository.
BUILDER_CONCURRENCY=2
BUILDER_BUILD_TIMEOUT_MS=900000
# A build log that prints without end is capped, and the truncation is written
# into the log so it is visible rather than silent.
BUILDER_MAX_LOG_LINES=5000
# How long a finished build's record and logs are kept before being dropped.
BUILDER_JOB_TTL_MS=3600000

# --- Secret encryption --------------------------------------------------------
# Encrypts per-project environment variables and git webhook secrets at rest.
# Without it those two write paths answer `engine_unavailable` rather than
# storing a plaintext secret, so this is required before the Environment and Git
# sections work. A 32-byte key, base64. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CLOUD_WAI_SECRET_ENCRYPTION_KEY=

# --- API server ---------------------------------------------------------------
# Where the API listens. A container host sets HOST=0.0.0.0; the reverse proxy
# in front terminates TLS.
HOST=0.0.0.0
PORT=8787
# Origins allowed to call the API from a browser, comma-separated, e.g.
# https://app.cloudwai.example. Never `*`: responses are per-user. Leave unset
# when the dashboard is served by the same host as the API (same origin).
CLOUD_WAI_ALLOWED_ORIGINS=

# --- Local development only ---------------------------------------------------
# Never set this in a production process: the fakes report success for work no
# engine performed. `buildEngines` refuses them when NODE_ENV=production.
CLOUD_WAI_USE_FAKE_ENGINES=false

# --- Temporary no-login bypass (demo only) -----------------------------------
# When DEMO_AUTOLOGIN=1, the dashboard asks the API for a demo session and skips
# the landing/sign-in pages, so a pre-launch demonstration opens straight into
# the workspace. Only this flag is compiled into the browser bundle; the email
# and password stay in the API process's environment and are never shipped to a
# browser. The API performs the password grant and rate-limits the route, so the
# bypass can be switched off (DEMO_AUTOLOGIN=0 and restart the API) without a
# rebuild. The account is a real user and every request carries a verified
# session; this only removes the sign-in step. Remove these settings (and the
# account) before public launch — sign-up is not yet exposed, so this stands in
# for it. Scope the account to a throwaway organization at the lowest role that
# renders the dashboard.
DEMO_AUTOLOGIN=0
DEMO_EMAIL=
DEMO_PASSWORD=
# Optional: demo sign-in attempts allowed per client per window (defaults 30/60s).
# DEMO_MAX_PER_WINDOW=30
# DEMO_RATE_WINDOW_MS=60000

# --- Reserved (documented, not read by this build) ---------------------------
# These name the operator's own edge and tenant plane. No code in this
# repository reads them yet, so setting one changes nothing; they are kept so
# the intended configuration is on record. They move up into a live section when
# the corresponding adapter operation is implemented — and the compiler already
# pins the CRS release it emits, so CRS_VERSION is what a future reconciliation
# will compare against, not a value that alters the ruleset today.
EDGE_IMPLEMENTATION=envoy
CRS_VERSION=4.30.0
CROWDSEC_LAPI_URL=
CROWDSEC_API_KEY=
# Tenant databases are provisioned *through Coolify* (ADR-0011), so they use
# the organization's Coolify credentials above; there is no separate database
# engine URL an adapter reads.
TENANT_POSTGRES_ADMIN_URL=
TENANT_POSTGRES_BACKUP_BUCKET=
