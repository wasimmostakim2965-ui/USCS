# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
VITE_SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/

# Server-only configuration. Never expose these through VITE_* variables.
NODE_ENV=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
# SUPABASE_SECRET_KEY=server-only-secret

# Public application URL used for server-generated return URLs.
CONTROL_PLANE_PUBLIC_URL=https://your-production-domain.example

# Self-operated data/compute plane feature gates.
# Keep false until the corresponding runtime and health checks are deployed.
DATA_PLANE_ENABLED=false
SECURITY_EDGE_ENABLED=false
# Optional self-hosted compute control API. The compute service must run
# Nixpacks builds, isolated Docker/Podman containers, outbound tunnels and
# expose /v1/deployments plus /v1/deployments/:id/rollback.
# COMPUTE_HOST=https://compute-control.internal
# COMPUTE_API_TOKEN=compute-control-server-token
# Optional trusted self-hosted edge control API. Keep server-side only.
# EDGE_API_URL=https://edge-control.internal
# EDGE_API_TOKEN=edge-control-server-token
# EDGE_HOST=edge-01.internal

# Stripe billing contract. Keep unset until a Stripe account, price and webhook exist.
# STRIPE_SECRET_KEY=sk_live_server_only
# STRIPE_WEBHOOK_SECRET=whsec_server_only
# STRIPE_PRICE_PREMIUM_MONTHLY=price_xxx

# Domain reseller is intentionally left unconfigured for now.
# DOMAIN_RESELLER_PROVIDER=
# DOMAIN_RESELLER_API_KEY=
# DOMAIN_RESELLER_ACCOUNT_ID=
